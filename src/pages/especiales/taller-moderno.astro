---
import Reportaje from "@/especiales/shared/Reportaje.astro";
import {
  diagnosisNiveles,
  ecosistemasBateria,
  erroresTrampas,
  herramientas,
  orden,
  rutas,
  tallerVsCasa,
  trilogiaEtapas,
} from "@/especiales/taller-moderno/data/taller";

const seoTitle = "Taller moderno · Herramientas a batería y diagnosis OBD2";
const seoDescription =
  "La revolución del taller casero: llaves de impacto a batería, carracas eléctricas y sistemas de diagnosis OBD2 sencillos y avanzados para moto y coche.";

const fichas = herramientas.map((h) => ({
  id: h.id,
  name: h.name,
  type: h.type,
  rank: h.rank,
  scoreValue: h.scoreValue,
  img: h.img,
  specs: h.specs,
  desc: h.desc,
  videos: h.videos,
}));

const cfg = {
  slug: "taller-moderno",
  migas: "Taller moderno",
