  },
  fichas: {
    title: "Las 8 fichas",
    desc: "Ábrela que te interese: motor, potencia, cambio, consumo, maletero, precio y garantía de cada modelo.",
    items: fichas,
  },
  dossier: {
    tablas: [
      {
        title: "Ficha técnica",
        desc: "Motor, potencia, cambio, maletero y garantía de cada modelo.",
        columns: [
          { label: "Modelo", key: "model" },
          { label: "Segmento", key: "segmento", mono: true },
          { label: "Motor", key: "motor" },
          { label: "Potencia", key: "potencia", mono: true },
          { label: "Cambio", key: "cambio" },
          { label: "Maletero", key: "maletero", align: "right" as const, mono: true },
          { label: "Garantía", key: "garantia", mono: true },
        ],
        rows: tecnicos,
      },
      {
        title: "Precios orientativos",
        desc: "PVP orientativo y observaciones.",
        columns: [
          { label: "Modelo", key: "model" },
          { label: "PVP orientativo", key: "pvp", mono: true },
          { label: "Observaciones", key: "obs" },
        ],
        rows: precios,
      },
      {
        title: "Consumo y mantenimiento",
        desc: "Consumo WLTP y notas generales de mantenimiento.",
        columns: [
          { label: "Modelo", key: "model" },
          { label: "Consumo", key: "consumo", align: "right" as const, mono: true },
          { label: "Mantenimiento", key: "mantenimiento" },
        ],
        rows: consumo,
      },
      {
        title: "Mantenimiento casero",
        desc: "Aceite y filtros, frenos, suspensión, batería, luces e interiores: qué puedes hacer tú y qué exige taller.",
        columns: [
          { label: "Modelo", key: "model" },
          { label: "Aceite y filtros", key: "aceiteFiltros" },
          { label: "Frenos", key: "frenos" },
          { label: "Suspensión", key: "suspension" },
          { label: "Batería y luces", key: "bateriaLuces" },
          { label: "Interior y exterior", key: "interiorExterior" },
        ],
        rows: mantenimiento,
      },
    ],
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: seoTitle,
      description: seoDescription,
      image: "https://tuanbyte.es/images/especiales/suvs-hev/og.png",
      datePublished: "2026-10-10",
      dateModified: "2026-10-10",
      inLanguage: "es",
      author: { "@type": "Person", name: "Tuanbyte" },
      publisher: { "@type": "Organization", name: "Tuanbyte" },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": "https://tuanbyte.es/especiales/suvs-hev",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Especiales", item: "https://tuanbyte.es/especiales" },
        { "@type": "ListItem", position: 2, name: "SUVs híbridos HEV", item: "https://tuanbyte.es/especiales/suvs-hev" },
      ],
    },
  ],
};
---

<Reportaje cfg={cfg} />
