    imgAlt: 'Juego de vasos 3/8" con carraca',
  },
  etapas: {
    title: "La ruta",
    desc: "De lo más básico a lo más específico. Las que llevan enlace ya tienen ficha desplegable; el resto llega en las siguientes tandas.",
    items: etapas,
  },
  ranking: {
    title: "El orden",
    desc: "Ponderación: lo usarás 40 % · sin ella no puedes 40 % · barata 20 %. El orden es el de compra: la primera es la que hay que tener antes.",
    criteria: [
      { key: "uso", label: "Lo usarás", weight: "40%" },
      { key: "desbloqueo", label: "Sin ella no puedes", weight: "40%" },
      { key: "barata", label: "Barata", weight: "20%" },
    ],
    rows: orden,
    winnerLabel: "la primera",
  },
  fichas: {
    title: "El taller, de un vistazo",
    desc: "Pica en cualquiera para desplegar su ficha: para qué sirve, qué desbloquea, la compra barata, la compra buena y el error típico que hay que evitar. Con el vídeo donde se usa.",
    items: fichas,
  },
  dossier: {
    tablas: [
      {
        id: "marcas",
        title: "Las marcas, una a una",
        desc: "De las opciones accesibles de súper (Lidl/Aldi) y ferretería a las grandes referencias profesionales (Milwaukee, DeWalt, Makita, Metabo, Facom). Con lo bueno, lo flojo y el veredicto real de taller.",
        columns: [
          { label: "Marca", key: "marca" },
          { label: "Gama", key: "gama" },
          { label: "Lo bueno", key: "bueno" },
          { label: "Lo flojo", key: "flojo" },
          { label: "Veredicto", key: "veredicto" },
