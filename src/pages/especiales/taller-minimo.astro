        desc: "Valores orientativos estándar (moto y coche). Consulta siempre el manual oficial de tu modelo antes de aplicar par.",
        columns: [
          { label: "Operación / Elemento", key: "operacion" },
          { label: "Par típico", key: "par", align: "right", mono: true },
          { label: "Dinamométrica recomendada", key: "llave" },
          { label: "Aviso de taller", key: "aviso" },
