          { label: "Consecuencia real", key: "consecuencia" },
          { label: "Regla de taller", key: "solucion" },
        ],
        rows: erroresTrampas,
        modelKey: "error",
      },
    ],
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: seoTitle,
      description: seoDescription,
      image: "https://tuanbyte.es/images/especiales/taller-minimo/og.png",
