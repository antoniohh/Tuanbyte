---
import Reportaje from "@/especiales/shared/Reportaje.astro";
import {
  erroresTrampas,
  etapas,
  herramientas,
  marcas,
  orden,
  paresApriete,
  rutas,
  tallerVsCasa,
} from "@/especiales/taller-minimo/data/taller";

const seoTitle = "El taller mínimo viable · Qué herramientas comprar y en qué orden";
const seoDescription =
  "Qué herramientas comprar para hacerle el mantenimiento a tu moto o tu coche en casa, en qué orden y de qué marca: tres etapas, fichas y presupuestos desde 100 €.";

const fichas = herramientas.map((h) => ({
  id: h.id,
  name: h.name,
  type: h.type,
  rank: h.rank,
  scoreValue: h.scoreValue,
  img: h.img,
  specs: h.specs,
  desc: h.desc,
  videos: h.videos,
}));

const cfg = {
  slug: "taller-minimo",
  migas: "El taller mínimo viable",
  seoTitle,
  seoDescription,
  ogImage: "images/especiales/taller-minimo/og.png",
  portada: {
    subtitle: "Qué comprar para empezar, y en qué orden",
    title: "El taller mínimo viable",
    intro:
      "Le haces el mantenimiento a tu moto o a tu coche y no eres mecánico. Ese es todo el requisito. Aquí está lo que hace falta comprar, en qué orden, de qué marca y por cuánto: desde los 100 € del primer juego de vasos hasta lo específico de tu modelo.",
    intro2:
      "No hay nada patrocinado: son las herramientas que se usan en el taller, con precios orientativos y sin enlaces de afiliación.",
    img: "/images/especiales/taller-minimo/portada.jpg",
    imgAlt: "El kit de arranque del taller",
    caption: "el kit de arranque · foto de taller",
    strip: ["3 etapas", "9 fichas de arranque", "desde 100 €", "sin patrocinio"],
  },
  veredicto: {
    winner: 'Juego de vasos 3/8" y carraca',
    score: "9,60",
    lead: 'Si solo vas a comprar una cosa, compra esta. El juego de vasos de 3/8" con carraca y vasos de 6 puntas es lo que se coge el 80 % del tiempo: afloja y aprieta casi todo, no redondea las tuercas duras y, con dos extensiones y una junta universal, llega a donde no entra nada más. Es la reina del taller mínimo.',
    factors: [
      {
        title: "Es la que más se usa",
        text: "De cada diez trabajos, ocho empiezan con una carraca en la mano.",
      },
      {
        title: "No redondea nada",
        text: "Las 6 puntas agarran la tuerca por la cara, no por la esquina, y no la estropean cuando está dura.",
      },
      {
        title: "Vale desde 25 €",
        text: "La versión del súper hace el trabajo; la buena cuesta unos 60 € y dura toda la vida.",
