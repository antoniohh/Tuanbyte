      dateModified: "2026-11-01",
      inLanguage: "es",
      author: { "@type": "Person", name: "Tuanbyte" },
      publisher: { "@type": "Organization", name: "Tuanbyte" },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": "https://tuanbyte.es/especiales/taller-minimo",
      },
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Especiales", item: "https://tuanbyte.es/especiales" },
        { "@type": "ListItem", position: 2, name: "El taller mínimo viable", item: "https://tuanbyte.es/especiales/taller-minimo" },
      ],
    },
