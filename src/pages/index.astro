---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Regleta from "@/components/Regleta.astro";
import TapeDivider from "@/components/TapeDivider.astro";
import Videos from "@/components/Videos.astro";
import Listas from "@/components/Listas.astro";
import Especiales from "@/components/Especiales.astro";
import Redes from "@/components/Redes.astro";
import Footer from "@/components/Footer.astro";
import { getVideos } from "@/lib/videos";
import { getPlaylists } from "@/lib/playlists";

const videos = await getVideos(10);
const playlists = await getPlaylists(5);
const [featured, ...rest] = videos;

const now = new Date();
const editionText = new Intl.DateTimeFormat("es-ES", {
  month: "long",
  year: "numeric",
}).format(now);
const aniosText = now.getFullYear() - 2016;

const title = "Tuanbyte — el catálogo del taller";
const description =
  "Mecánica casera con la CB250, bricolaje en el chalet y tecnología de uso diario: todo probado, con su coste real y sin letra pequeña.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero featured={featured} editionText={editionText} aniosText={aniosText} />
    <Regleta ultimoTexto={featured.dateText} listados={videos.length} />
    <Videos videos={rest} />
    <TapeDivider />
    <Listas playlists={playlists} />
    <TapeDivider flip />
    <Especiales />
    <TapeDivider />
    <Redes />
  </main>
  <Footer />
</BaseLayout>
