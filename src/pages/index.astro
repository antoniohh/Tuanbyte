---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Videos from "@/components/Videos.astro";
import Pilares from "@/components/Pilares.astro";
import Especiales from "@/components/Especiales.astro";
import Redes from "@/components/Redes.astro";
import Footer from "@/components/Footer.astro";
import { getVideos } from "@/lib/videos";

const videos = await getVideos(6);

const title = "Tuanbyte — mecánica casera, bricolaje y tecnología";
const description =
  "Mecánica casera con una Honda CB250 TwoFifty, bricolaje con herramientas low-cost y tecnología sin humo, contados paso a paso con el coste real.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Videos videos={videos} />
    <Pilares />
    <Especiales />
    <Redes />
  </main>
  <Footer />
</BaseLayout>
