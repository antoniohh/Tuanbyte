---
interface Props {
  subtitle: string;
  title: string;
  intro: string;
  intro2?: string;
  img: string;
  imgAlt: string;
  caption: string;
  strip: string[];
}

const { subtitle, title, intro, intro2, img, imgAlt, caption, strip } = Astro.props;
---

<section>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 pb-12 pt-8 sm:px-8 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="font-marker text-2xl text-minium">{subtitle}</p>
      <h1
        class="mt-3 font-display text-[clamp(2.75rem,7vw,4.75rem)] font-extrabold uppercase leading-[0.9] tracking-tight text-ink"
      >
        {title}
      </h1>
      <p class="mt-5 max-w-[58ch] text-xl leading-relaxed text-ink/90">{intro}</p>
      {intro2 ? <p class="mt-4 max-w-[58ch] leading-relaxed text-ink-soft">{intro2}</p> : null}
    </div>

    <div class="lg:col-span-5">
      <figure class="tape canto bg-paper px-4 pb-4 pt-6">
        <img src={img} alt={imgAlt} class="h-52 w-full object-contain" loading="eager" />
        <figcaption class="mt-3 text-center font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-ink-soft">
          {caption}
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<aside class="border-y-2 border-ink bg-ink text-paper" aria-label="Ficha del reportaje">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-2 px-5 py-3 font-mono text-xs sm:px-8">
    <span class="uppercase tracking-[0.14em] text-paper">Reportaje</span>
    {
      strip.map((s) => (
        <span class="text-strike">{s}</span>
      ))
    }
  </div>
</aside>
