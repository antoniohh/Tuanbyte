---
interface Factor {
  title: string;
  text: string;
}

interface Props {
  title: string;
  winner: string;
  score: string;
  lead: string;
  factors: Factor[];
  img: string;
  imgAlt: string;
}

const { title = "El veredicto", winner, score, lead, factors, img, imgAlt } = Astro.props as Props;
---

<section id="veredicto" class="scroll-mt-24 bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5">
        <div class="flex h-64 items-center justify-center lg:h-full">
          <img src={img} alt={imgAlt} class="max-h-72 w-full object-contain" loading="lazy" />
        </div>
      </div>

      <div class="lg:col-span-7">
        <h2
          class="font-display text-4xl font-extrabold uppercase leading-[0.9] tracking-tight text-paper sm:text-5xl"
        >
          {title}
        </h2>

        <div class="mt-5 flex flex-wrap items-baseline gap-x-5 gap-y-2 border-b border-paper/25 pb-4">
          <span class="font-display text-3xl font-bold text-paper sm:text-4xl">{winner}</span>
          <span class="font-mono text-2xl text-strike">{score}<span class="text-paper/50">/10</span></span>
        </div>

        <p class="mt-5 max-w-[62ch] leading-relaxed text-paper/85">{lead}</p>

        <ol class="mt-8 grid list-none grid-cols-1 gap-x-10 p-0 sm:grid-cols-2">
          {
            factors.map((f) => (
              <li class="border-t border-paper/20 py-5">
                <h3 class="font-display text-xl font-bold text-paper">{f.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-paper/70">{f.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
