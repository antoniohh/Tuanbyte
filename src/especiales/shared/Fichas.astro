---
import { formatScore } from "./lib";

interface Spec {
  label: string;
  value: string;
}

interface Ficha {
  id: string;
  name: string;
  type: string;
  rank: number;
  scoreValue: number;
  img: string;
  specs: Spec[];
  desc: string;
  diyText?: string;
  badge?: "high" | "med" | "low";
}

interface Props {
  id?: string;
  title: string;
  desc: string;
  fichas: Ficha[];
}

const { id = "fichas", title, desc, fichas } = Astro.props;

const badgeClass: Record<NonNullable<Ficha["badge"]>, string> = {
  high: "bg-ink text-paper",
  med: "border border-ink-line text-ink",
  low: "bg-minium text-paper",
};
---

<section id={id} class="scroll-mt-24">
  <div class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 lg:pt-20">
    <h2
      class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl"
    >
      {title}
    </h2>
    <p class="mt-2 max-w-[68ch] text-sm leading-relaxed text-ink-soft">{desc}</p>
  </div>

  <div
    class="mx-auto mt-8 grid max-w-6xl grid-cols-2 gap-3 px-5 sm:grid-cols-3 sm:px-8 lg:grid-cols-4"
  >
    {
      fichas.map((f) => (
        <details
          id={`ficha-${f.id}`}
          class="group scroll-mt-24 border-2 border-ink bg-paper open:col-span-full open:bg-paper-2/60 open:lg:grid open:lg:grid-cols-[20rem_1fr] open:lg:items-start"
        >
          <summary class="flex h-full cursor-pointer flex-col p-3 transition-colors hover:bg-paper-2 [&::-webkit-details-marker]:hidden lg:group-open:h-auto lg:group-open:border-r-2 lg:group-open:border-ink">
            <span class="flex items-baseline justify-between">
              <span class="font-mono text-[0.625rem] text-ink-soft tabular-nums">
                {String(f.rank).padStart(2, "0")}
              </span>
              <span class="font-mono text-xs font-semibold text-minium tabular-nums">
                {formatScore(f.scoreValue)}
              </span>
            </span>

            <span class="mt-1 flex h-24 items-center justify-center lg:group-open:h-52">
              <img
                src={f.img}
                alt={f.name}
                class="max-h-24 w-full object-contain"
                loading="lazy"
              />
            </span>

            <span class="mt-2 font-display text-base font-bold uppercase leading-tight tracking-tight text-ink">
              {f.name}
            </span>
            <span class="mt-0.5 font-mono text-[0.625rem] uppercase tracking-[0.08em] text-ink-soft">
              {f.type}
            </span>
            <span class="mt-auto pt-2 font-marker text-lg text-ink">
              <span class="group-open:hidden">ver ficha ↴</span>
              <span class="hidden group-open:inline text-ink-soft">cerrar ↥</span>
            </span>
          </summary>

          <div class="border-t-2 border-ink px-5 py-5 lg:group-open:border-t-0">
            {
              f.badge && f.diyText ? (
                <span
                  class:list={[
                    "mb-3 inline-block px-2 py-1 font-mono text-[0.625rem] uppercase tracking-[0.1em]",
                    badgeClass[f.badge],
                  ]}
                >
                  casero {f.diyText}
                </span>
              ) : null
            }
            <div>
              <dl class="grid gap-x-8 sm:grid-cols-2">
                {f.specs.map((s) => (
                  <div class="flex items-baseline gap-3 border-b border-ink-line/60 py-1.5">
                    <dt class="w-28 shrink-0 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-soft">
                      {s.label}
                    </dt>
                    <dd class="min-w-0 flex-1 font-mono text-[0.8125rem] text-ink">
                      {s.value}
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="mt-4 leading-relaxed text-ink/85">{f.desc}</p>
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>
