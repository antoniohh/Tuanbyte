---
interface Item {
  label: string;
  id?: string;
}

interface Etapa {
  n: number;
  title: string;
  lema: string;
  presupuesto: string;
  href?: string;
  active?: boolean;
  items: Item[];
}

interface Props {
  id?: string;
  title?: string;
  desc: string;
  etapas: Etapa[];
  currentEtapa?: number;
}

const { id = "ruta", title = "La ruta", desc, etapas, currentEtapa } = Astro.props;
---

<section id={id} class="scroll-mt-24">
  <div class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 lg:pt-20">
    <h2
      class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl"
    >
      {title}
    </h2>
    <p class="mt-2 max-w-[68ch] text-sm leading-relaxed text-ink-soft">{desc}</p>
  </div>

  <div class="mx-auto mt-8 grid max-w-6xl gap-4 px-5 sm:px-8 lg:grid-cols-3">
    {
      etapas.map((e) => {
        const isActive = currentEtapa ? currentEtapa === e.n : Boolean(e.active);
        return (
          <article
            class:list={[
              "canto flex flex-col p-5 transition-all",
              isActive
                ? "border-2 border-minium bg-paper shadow-md ring-2 ring-minium/20"
                : "border-2 border-ink bg-paper hover:border-minium/70",
            ]}
          >
            <div class="flex items-baseline justify-between gap-3">
              <span class="font-display text-5xl font-extrabold leading-none text-minium tabular-nums">
                {String(e.n).padStart(2, "0")}
              </span>
              <div class="flex items-center gap-2">
                {isActive && (
                  <span class="border border-minium bg-minium/10 px-1.5 py-0.5 font-mono text-[0.625rem] font-bold uppercase tracking-wider text-minium">
                    Estás aquí
                  </span>
                )}
                <span class="font-mono text-[0.625rem] uppercase tracking-[0.1em] text-ink-soft">
                  {e.presupuesto}
                </span>
              </div>
            </div>

            <h3 class="mt-3 font-display text-2xl font-bold uppercase leading-tight tracking-tight text-ink">
              {e.href && !isActive ? (
                <a href={e.href} class="hover:text-minium transition-colors">
                  {e.title}
                </a>
              ) : (
                e.title
              )}
            </h3>
            <p class="mt-2 font-marker text-xl leading-snug text-minium">{e.lema}</p>

            <ul class="mt-4 flex-1 space-y-1.5 border-t border-ink-line/60 pt-4">
              {e.items.map((it) => {
                const targetUrl = isActive
                  ? it.id ? `#ficha-${it.id}` : null
                  : e.href && it.id ? `${e.href}#ficha-${it.id}` : null;

                return (
                  <li class="flex items-baseline gap-2">
                    <span class="font-mono text-[0.625rem] text-ink-line">·</span>
                    {targetUrl ? (
                      <a
                        href={targetUrl}
                        class="font-mono text-[0.75rem] text-ink underline decoration-dotted underline-offset-2 transition-colors hover:text-minium"
                      >
                        {it.label}
                      </a>
                    ) : (
                      <span class="font-mono text-[0.75rem] text-ink-soft">{it.label}</span>
                    )}
                  </li>
                );
              })}
            </ul>

            {e.href && (
              <div class="mt-5 border-t border-ink-line/40 pt-3">
                {isActive ? (
                  <span class="inline-flex items-center gap-1.5 font-mono text-[0.6875rem] font-bold uppercase tracking-wider text-minium">
                    ● Viendo esta entrega
                  </span>
                ) : (
                  <a
                    href={e.href}
                    class="group inline-flex items-center gap-1 font-mono text-[0.6875rem] font-bold uppercase tracking-wider text-ink transition-colors hover:text-minium"
                  >
                    <span>Abrir este especial</span>
                    <span class="transition-transform group-hover:translate-x-0.5">→</span>
                  </a>
                )}
              </div>
            )}
          </article>
        );
      })
    }
  </div>
</section>
