---
import { formatDec, formatScore, modelClass, tagChip } from "./lib";

interface Criterion {
  key: string;
  label: string;
  weight: string;
}

interface Row {
  model: string;
  tag: string | null;
  nota: number;
  [key: string]: unknown;
}

interface Props {
  id?: string;
  title?: string;
  desc: string;
  criteria: Criterion[];
  rows: Row[];
  winnerLabel?: string;
}

const {
  id = "clasificacion",
  title = "El cuadro",
  desc,
  criteria,
  rows,
  winnerLabel = "ganadora",
} = Astro.props;
---

<section id={id} class="scroll-mt-24">
  <div class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 lg:pt-20">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2
        class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl"
      >
        {title}
      </h2>
    </div>
    <p class="mt-2 max-w-[68ch] text-sm leading-relaxed text-ink-soft">{desc}</p>
  </div>

  <div class="mx-auto mt-6 max-w-6xl px-5 sm:px-8">
    <div class="overflow-x-auto border-2 border-ink">
      <table class="w-full min-w-[900px] border-collapse text-left">
        <thead>
          <tr class="border-b-2 border-ink bg-paper-2">
            <th class="px-4 py-3 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-soft">
              Pos.
            </th>
            <th class="px-4 py-3 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-soft">
              Modelo
            </th>
            {
              criteria.map((c) => (
                <th class="px-4 py-3 text-right font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-soft">
                  {c.label}
                  <span class="ml-1 text-ink-line">{c.weight}</span>
                </th>
              ))
            }
            <th class="px-4 py-3 text-right font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink">
              Nota
            </th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row, i) => {
              const isTop = i === 0;
              const chip = tagChip(row.tag as never, winnerLabel);
              return (
                <tr
                  class:list={[
                    "transition-colors hover:bg-paper-2",
                    i !== rows.length - 1 ? "border-b border-ink-line" : "",
                    isTop ? "bg-strike/25" : "",
                  ]}
                >
                  <td class="px-4 py-3 align-middle">
                    <span
                      class:list={[
                        "font-display text-2xl font-extrabold tabular-nums leading-none",
                        isTop ? "text-minium" : "text-ink",
                      ]}
                    >
                      {String(i + 1).padStart(2, "0")}
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-4 py-3 align-middle">
                    <span class:list={["font-display text-lg", modelClass(row.tag as never)]}>
                      {row.model}
                    </span>
                    {chip ? (
                      <span
                        class:list={[
                          "ml-3 inline-block px-2 py-0.5 align-middle font-mono text-[0.625rem] uppercase tracking-[0.1em]",
                          chip.class,
                        ]}
                      >
                        {chip.label}
                      </span>
                    ) : null}
                  </td>
                  {criteria.map((c) => (
                    <td class="px-4 py-3 text-right align-middle font-mono text-sm text-ink-soft tabular-nums">
                      {formatDec(Number(row[c.key]))}
                    </td>
                  ))}
                  <td class="px-4 py-3 text-right align-middle">
                    <span
                      class:list={[
                        "font-mono text-lg font-semibold tabular-nums",
                        isTop ? "text-minium" : "text-ink",
                      ]}
                    >
                      {formatScore(row.nota)}
                    </span>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
