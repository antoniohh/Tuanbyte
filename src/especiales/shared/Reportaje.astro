---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Migas from "@/especiales/shared/Migas.astro";
import Portada from "@/especiales/shared/Portada.astro";
import Veredicto from "@/especiales/shared/Veredicto.astro";
import Etapas from "@/especiales/shared/Etapas.astro";
import Ranking from "@/especiales/shared/Ranking.astro";
import Fichas from "@/especiales/shared/Fichas.astro";
import TablaTecnica from "@/especiales/shared/TablaTecnica.astro";
import { modelClass } from "@/especiales/shared/lib";

interface Tabla {
  id?: string;
  title: string;
  desc: string;
  columns: { label: string; key: string; align?: "left" | "right"; mono?: boolean }[];
  rows: Record<string, unknown>[];
  modelKey?: string;
}

interface Etapa {
  n: number;
  title: string;
  lema: string;
  presupuesto: string;
  href?: string;
  active?: boolean;
  items: { label: string; id?: string }[];
}

interface ApartadoBloque {
  title: string;
  subtitle?: string;
  text: string;
  note?: string;
}

interface ApartadoDestacado {
  id?: string;
  kicker?: string;
  title: string;
  intro?: string;
  blocks?: ApartadoBloque[];
}

interface Props {
  cfg: {
    slug: string;
    migas: string;
    seoTitle: string;
    seoDescription: string;
    ogImage: string;
    portada: Record<string, unknown>;
    veredicto: Record<string, unknown>;
    etapas?: { title?: string; desc: string; items: Etapa[]; currentEtapa?: number };
    apartadoDestacado?: ApartadoDestacado;
    tablaAntes?: Tabla;
    ranking: {
      title?: string;
      desc: string;
      criteria: { key: string; label: string; weight: string }[];
      rows: Record<string, unknown>[];
      winnerLabel?: string;
    };
    fichas: { title: string; desc: string; items: Record<string, unknown>[] };
    dossier: { tablas: Tabla[] };
    jsonLd: Record<string, unknown>[];
  };
}

const { cfg } = Astro.props;
---

<BaseLayout
  title={cfg.seoTitle}
  description={cfg.seoDescription}
  image={cfg.ogImage}
  jsonLd={cfg.jsonLd}
>
  <Header />
  <main class="pb-16 lg:pb-24">
    <Migas title={cfg.migas} />
    <Portada {...cfg.portada} />
    <Veredicto {...cfg.veredicto} />

    {
      cfg.etapas && (
        <Etapas
          title={cfg.etapas.title}
          desc={cfg.etapas.desc}
          etapas={cfg.etapas.items}
          currentEtapa={cfg.etapas.currentEtapa}
        />
      )
    }

    {
      cfg.apartadoDestacado && (
        <section id={cfg.apartadoDestacado.id || "analisis"} class="scroll-mt-24 border-y border-ink-line/50 bg-paper-tint py-12 lg:py-16">
          <div class="mx-auto max-w-6xl px-5 sm:px-8">
            <span class="font-mono text-xs font-bold uppercase tracking-widest text-minium">
              {cfg.apartadoDestacado.kicker || "Análisis técnico de taller"}
            </span>
            <h2 class="mt-2 font-display text-3xl font-extrabold uppercase tracking-tight text-ink sm:text-4xl">
              {cfg.apartadoDestacado.title}
            </h2>
            {cfg.apartadoDestacado.intro && (
              <p class="mt-3 max-w-[75ch] text-base leading-relaxed text-ink/90 font-sans">
                {cfg.apartadoDestacado.intro}
              </p>
            )}

            {cfg.apartadoDestacado.blocks && (
              <div class="mt-8 grid gap-5 md:grid-cols-3">
                {cfg.apartadoDestacado.blocks.map((b) => (
                  <div class="canto border-2 border-ink bg-paper p-5 flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between gap-2 border-b border-ink-line/40 pb-2">
                        <h3 class="font-display text-xl font-bold uppercase tracking-tight text-ink">
                          {b.title}
                        </h3>
                        {b.subtitle && (
                          <span class="font-mono text-[0.6875rem] font-bold uppercase tracking-wider text-minium">
                            {b.subtitle}
                          </span>
                        )}
                      </div>
                      <p class="mt-3 text-sm leading-relaxed text-ink-soft whitespace-pre-line">
                        {b.text}
                      </p>
                    </div>
                    {b.note && (
                      <div class="mt-4 border-t border-ink-line/40 pt-2 font-mono text-[0.6875rem] text-ink-soft italic">
                        {b.note}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      cfg.tablaAntes && (
        <TablaTecnica
          id={cfg.tablaAntes.id}
          title={cfg.tablaAntes.title}
          desc={cfg.tablaAntes.desc}
          columns={cfg.tablaAntes.columns}
          rows={cfg.tablaAntes.rows}
          modelKey={cfg.tablaAntes.modelKey}
        />
      )
    }

    <Ranking
      title={cfg.ranking.title}
      desc={cfg.ranking.desc}
      criteria={cfg.ranking.criteria}
      rows={cfg.ranking.rows as never}
      winnerLabel={cfg.ranking.winnerLabel}
    />

    <Fichas title={cfg.fichas.title} desc={cfg.fichas.desc} fichas={cfg.fichas.items as never} />

    <div class="mx-auto max-w-6xl px-5 pt-14 sm:px-8 lg:pt-20" id="datos">
      <h2 class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl">
        Dossier
      </h2>
      <p class="mt-2 max-w-[62ch] text-sm leading-relaxed text-ink-soft">
        Los apéndices técnicos completos. Cifras orientativas, no tarifas oficiales.
      </p>
    </div>

    {
      cfg.dossier.tablas.map((t) => (
        <TablaTecnica
          id={t.id}
          title={t.title}
          desc={t.desc}
          columns={t.columns}
          rows={t.rows}
          modelKey={t.modelKey}
          modelClass={(r) => modelClass(r.tag as never)}
        />
      ))
    }
  </main>
  <Footer />
</BaseLayout>
