---
import "@/styles/global.css";
import Cookies from "@/components/Cookies.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, image, jsonLd = [] } = Astro.props;
const site = Astro.site?.href ?? "https://tuanbyte.es/";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? "images/og.png", site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Antonio Horrillo" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon.png" sizes="48x48" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f2ead8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600;900&family=Caveat:wght@600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title"
      content={title}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Tuanbyte" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tuanbyte" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Consent Mode v2 & Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      var savedConsent = null;
      try {
        savedConsent = localStorage.getItem("tb-consent");
      } catch (e) {}

      var isGranted = savedConsent === "granted";

      gtag("consent", "default", {
        analytics_storage: isGranted ? "granted" : "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        wait_for_update: 500,
      });

      gtag("js", new Date());
      gtag("config", "G-JPK8PQEMEM", {
        anonymize_ip: true,
      });
    </script>
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-JPK8PQEMEM"
    ></script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Tuanbyte",
        alternateName: "Antonio Horrillo",
        url: site,
        email: "mailto:info@tuanbyte.es",
        sameAs: [
          "https://www.youtube.com/tuanbyte",
          "https://twitter.com/tuanbyte",
          "https://instagram.com/tuanbyte",
          "https://www.tiktok.com/@tuanbyte",
          "https://www.facebook.com/tuanbyte",
          "https://www.pinterest.es/tuanbyte",
        ],
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Tuanbyte",
        url: site,
        inLanguage: "es",
        publisher: { "@type": "Person", name: "Tuanbyte" },
      })}
    />
    {
      jsonLd.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body class="bg-paper text-ink min-h-dvh antialiased">
    <slot />
    <Cookies />
  </body>
</html>
