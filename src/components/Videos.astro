---
import type { Video } from "@/lib/videos";

interface Props {
  videos: Video[];
}

const { videos } = Astro.props;
const fmt = new Intl.NumberFormat("es-ES");
---

<section id="catalogo" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl">
        Última hornada
      </h2>
      <p class="font-marker text-2xl text-minium">
        lo recién impreso, de corrido
      </p>
    </div>

    <div class="mt-10 border-2 border-ink bg-paper">
      <div class="hidden grid-cols-[7rem_1fr_auto_auto_minmax(9rem,auto)] gap-4 border-b-2 border-ink bg-paper-2 px-5 py-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-soft sm:grid">
        <span>ref.</span>
        <span>pieza</span>
        <span>fecha</span>
        <span class="text-right">vistas</span>
        <span></span>
      </div>
      {
        videos.map((v, i) => (
          <a
            href={v.url}
            target="_blank"
            rel="noopener"
            class:list={[
              "group grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 px-4 py-4 transition-colors hover:bg-paper-2 sm:grid-cols-[7rem_1fr_auto_auto_minmax(9rem,auto)] sm:px-5",
              i !== videos.length - 1 ? "border-b border-ink-line" : "",
            ]}
          >
            <span class="hidden font-mono text-xs tracking-[0.08em] text-ink-soft sm:block">
              {v.id.slice(-4).toUpperCase()}
            </span>
            <span class="flex min-w-0 items-center gap-4">
              <img
                src={v.thumbnail}
                alt={`Miniatura de «${v.title}»`}
                class="aspect-video w-28 shrink-0 border border-ink object-cover"
                loading="lazy"
              />
              <span class="min-w-0">
                <span class="block truncate font-semibold text-ink group-hover:text-minium sm:text-lg">
                  {v.title}
                </span>
                <span class="font-mono text-xs text-ink-soft sm:hidden">{v.dateText}</span>
              </span>
            </span>
            <span class="hidden font-mono text-xs text-ink-soft sm:block">{v.dateText}</span>
            <span class="hidden font-mono text-xs tabular-nums text-ink-soft sm:block">
              {v.viewsText ? v.viewsText.replace(" visualizaciones", "") : "—"}
            </span>
            <span class="justify-self-end font-marker text-xl text-ink transition-colors group-hover:text-minium">
              <>
                {v.id ? "ver ficha ↗" : ""}
              </>
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-6 font-marker text-2xl text-ink">
      piezas descatalogadas y vídeos con solera,
      <a
        href="https://www.youtube.com/tuanbyte"
        target="_blank"
        rel="noopener"
        class="border-b-2 border-ink pb-0.5 transition-colors hover:border-minium hover:text-minium"
      >
        en el almacén del canal ↗
      </a>
    </p>
  </div>
</section>
