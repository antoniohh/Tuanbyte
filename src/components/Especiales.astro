---
const anexos = [
  {
    href: "https://especiales.antoniohorrillo.com/#/guia-motos",
    shot: "/images/anexo-guia-motos.png",
    title: "Guía de motos de media cilindrada",
    text: "14 motos A2 retro/scrambler/roadster/trail a examen: fiabilidad, mantenimiento casero, precios y un ranking con cuentas claras.",
    alt: "Portada del especial Guía de motos de media cilindrada",
  },
  {
    href: "https://especiales.antoniohorrillo.com/#/suv-hev",
    shot: "/images/anexo-suv-hev.png",
    title: "SUVs híbridos HEV",
    text: "8 SUVs de hibridación completa (segmentos B y C) comparados: consumo, maletero, fiabilidad y coste de propiedad.",
    alt: "Portada del especial SUVs híbridos HEV",
  },
];
---

<section id="anexos" class="scroll-mt-20 border-b-2 border-ink">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl">
        Folletos anexos
      </h2>
      <p class="font-marker text-2xl text-minium">
        cuando un tema da para reportaje entero
      </p>
    </div>
    <p class="mt-3 max-w-[60ch] leading-relaxed text-ink-soft">
      Reportajes a fondo con tablas y fichas, impresos en el especial de
      antoniohorrillo.com — la otra mitad de la casa.
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      {
        anexos.map((a, i) => (
          <a
            href={a.href}
            class:list={[
              "canto group block border-2 border-ink bg-paper",
              i === 0 ? "rotate-[-0.8deg]" : "rotate-[0.9deg]",
            ]}
          >
            <img
              src={a.shot}
              alt={a.alt}
              class="aspect-[16/10] w-full border-b-2 border-ink object-cover object-top"
              loading="lazy"
            />
            <div class="px-6 py-5">
              <h3 class="font-display text-2xl font-bold uppercase tracking-tight text-ink group-hover:text-minium">
                {a.title}
              </h3>
              <p class="mt-2 leading-relaxed text-ink/80">{a.text}</p>
              <p class="mt-4 font-marker text-xl text-minium">leer el folleto ↗</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
