---
const reportajes = [
  {
    href: "/especiales/guia-motos",
    title: "Guía de motos de media cilindrada",
    kicker: "14 modelos",
    text: "Motos retro, scrambler, roadster y trail a examen: fiabilidad, mantenimiento casero, precios y un ranking con cuentas claras.",
    img: "/images/especiales/guia-motos/honda-cl500.png",
    alt: "Honda CL 500, ganadora de la guía de motos",
    caption: "honda cl 500 · la ganadora",
    tilt: "lg:-rotate-[0.7deg]",
  },
  {
    href: "/especiales/suvs-hev",
    title: "SUVs híbridos HEV",
    kicker: "8 modelos",
    text: "Solo híbridos completos (HEV) de segmentos B y C: consumo, maletero, garantía y coste de propiedad, con ranking y fichas.",
    img: "/images/especiales/suvs-hev/kia-niro.png",
    alt: "Kia Niro HEV, ganador de la comparativa de SUVs",
    caption: "kia niro hev · el ganador",
    tilt: "lg:rotate-[0.8deg]",
  },
  {
    href: "/especiales/taller-minimo",
    title: "El taller mínimo viable",
    kicker: "desde 100 €",
    text: "Qué comprar para hacerle el mantenimiento a tu moto o tu coche en casa, en qué orden y de qué marca. De lo más básico a lo más específico.",
    img: "/images/especiales/taller-minimo/portada.svg",
    alt: "El kit de arranque del taller",
    caption: "el kit de arranque",
    tilt: "lg:-rotate-[0.6deg]",
  },
];
---

<section id="especiales" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl">
        Especiales
      </h2>
      <p class="font-marker text-2xl text-minium">
        cuando un tema da para reportaje entero
      </p>
    </div>
    <p class="mt-3 max-w-[60ch] leading-relaxed text-ink-soft">
      Reportajes comparativos con fichas, tablas y ranking multicriterio. Los
      mismos criterios con los que elijo y mantengo lo que enseño en el canal.
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      {
        reportajes.map((r) => (
          <a
            href={r.href}
            class:list={["tape canto group block bg-paper px-5 pt-6 pb-5", r.tilt]}
          >
            <div class="flex h-56 items-center justify-center">
              <img
                src={r.img}
                alt={r.alt}
                class="max-h-56 w-full object-contain"
                loading="lazy"
              />
            </div>
            <p class="mt-3 text-center font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-ink-soft">
              {r.caption}
            </p>
            <div class="mt-4 flex items-baseline justify-between gap-3">
              <h3 class="font-display text-2xl font-bold uppercase tracking-tight text-ink group-hover:text-minium">
                {r.title}
              </h3>
              <span class="shrink-0 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-minium">
                {r.kicker}
              </span>
            </div>
            <p class="mt-3 leading-relaxed text-ink/80">{r.text}</p>
            <p class="mt-4 font-marker text-xl text-minium">leer el reportaje ↗</p>
          </a>
        ))
      }
    </div>

    <p class="mt-6 font-marker text-2xl text-ink">
      todos los reportajes, en
      <a
        href="/especiales"
        class="border-b-2 border-ink pb-0.5 transition-colors hover:border-minium hover:text-minium"
      >
        la sección de especiales ↗
      </a>
    </p>
  </div>
</section>
