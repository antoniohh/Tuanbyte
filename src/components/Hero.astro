---
import type { Video } from "@/lib/videos";

interface Props {
  featured: Video;
  editionText: string;
}

const { featured, editionText } = Astro.props;
---

<section>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 pb-14 pt-14 sm:px-8 lg:grid-cols-12 lg:pt-20">
    <div class="lg:col-span-7">
      <h1
        class="mt-3 font-display text-[clamp(3.25rem,9vw,6rem)] font-extrabold uppercase leading-[0.9] tracking-tight text-ink"
      >
        El catálogo<br />del taller
      </h1>
      <p class="mt-4 font-marker text-2xl text-minium">
        edición continua — {editionText}
        <span class="whitespace-nowrap">· desde enero de 2016</span>
      </p>
      <p class="mt-6 max-w-[56ch] text-xl leading-relaxed text-ink/90">
        Aquí no hay estrenos de escaparate. Desde la CB250 en el garaje hasta
        la última reforma del chalet o la tecnología que uso a diario: todo lo
        que enseño está probado, con su coste real y sin letra pequeña.
      </p>
      <p class="mt-4 max-w-[56ch] text-xl leading-relaxed text-ink-soft">
        Si te van las cosas bien hechas y sin humo, quédate por aquí.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-5">
        <a
          href="https://www.youtube.com/tuanbyte"
          target="_blank"
          rel="noopener"
          class="sello bg-minium px-6 py-4 font-display text-xl font-bold uppercase tracking-wide text-paper shadow-[3px_3px_0_0_var(--color-ink)]"
        >
          Suscríbete al canal
        </a>
        <a
          href="#catalogo"
          class="border-b-2 border-ink pb-0.5 font-marker text-2xl text-ink transition-colors hover:border-minium hover:text-minium"
        >
          ver los últimos vídeos ↓
        </a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <article class="tape canto bg-paper px-5 pt-6 pb-5 shadow-[0_1px_0_0_var(--color-paper-3)]">
        <p class="flex items-center gap-2 font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-ink-soft">
          <svg class="h-3 w-3 text-minium" viewBox="0 0 12 12" aria-hidden="true">
            <rect x="1" y="1" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" />
            <rect x="4" y="4" width="4" height="4" fill="currentColor" />
          </svg>
          vídeo nº {featured.id.slice(-4).toUpperCase()}
        </p>
        <a href={featured.url} target="_blank" rel="noopener" class="group block">
          <img
            src={featured.thumbnail.replace("mqdefault", "hqdefault")}
            alt={`Miniatura del vídeo «${featured.title}»`}
            class="mt-3 aspect-video w-full border-2 border-ink object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <h2 class="mt-4 font-display text-2xl font-bold leading-tight text-ink group-hover:text-minium">
            {featured.title}
          </h2>
          <p class="mt-1 font-mono text-xs text-ink-soft">
            {featured.dateText}
            {
              featured.viewsText ? (
                <span class="text-minium"> {featured.viewsText.replace('visualizaciones', 'vistas')}</span>
              ) : null
            }
          </p>
          <p class="mt-3 inline-block border-b-2 border-ink pb-0.5 font-marker text-xl text-ink group-hover:border-minium group-hover:text-minium">
            ver el vídeo ↗
          </p>
        </a>
      </article>
    </div>
  </div>
</section>
