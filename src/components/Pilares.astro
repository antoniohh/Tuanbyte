---
const pilares = [
  {
    n: "01",
    title: "Mecánica casera",
    tag: "serie CB250 TwoFifty",
    text: "La Honda CB250 TwoFifty como proyecto de serie: pastillas de tambor, kit de arrastre, bujías, LEDs homologados… cada operación con sus costes reales y lo que NO conviene hacer.",
    href: "https://www.youtube.com/tuanbyte",
  },
  {
    n: "02",
    title: "Bricolaje y herramientas",
    tag: "parkside · workzone",
    text: "Rejuntados, humedades, pinturas y restauraciones en casa, con las herramientas low-cost de Lidl y Aldi (Parkside y Workzone) puestas a prueba de verdad.",
    href: "https://www.youtube.com/tuanbyte",
  },
  {
    n: "03",
    title: "Tecnología",
    tag: "linux · obs · web",
    text: "Linux de sobremesa (Zorin OS), OBS, desarrollo web y el gadgets que uso para grabar: lo que funciona, lo que no y cuánto cuesta.",
    href: "https://github.com/tuanbyte",
  },
];
---

<section id="pilares" class="border-b border-white/10 bg-white/[0.02]">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
    <h2 class="text-3xl font-bold tracking-tight text-neutral-50 sm:text-4xl">
      Qué hace Tuanbyte
    </h2>

    <div class="mt-12 divide-y divide-neutral-800 border-t-2 border-neutral-800">
      {
        pilares.map((p) => (
          <div class="grid gap-4 py-8 sm:grid-cols-[5rem_1fr_auto] sm:gap-8 lg:py-10">
            <p class="font-mono text-3xl font-bold text-neutral-700" aria-hidden="true">
              {p.n}
            </p>
            <div class="min-w-0">
              <h3 class="text-2xl font-bold text-neutral-50">
                {p.title}
                <span class="ml-3 align-middle font-mono text-[0.6875rem] font-normal uppercase tracking-[0.14em] text-amber-300">
                  {p.tag}
                </span>
              </h3>
              <p class="mt-3 max-w-[64ch] leading-relaxed text-neutral-400">{p.text}</p>
            </div>
            <a
              href={p.href}
              target="_blank"
              rel="noopener"
              class="self-end border-b border-neutral-700 pb-0.5 font-mono text-sm text-neutral-300 transition-colors hover:border-amber-300 hover:text-amber-300"
            >
              ver en el canal ↗
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
