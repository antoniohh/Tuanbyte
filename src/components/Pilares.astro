---
const secciones = [
  {
    dept: "Motocicletas",
    tag: "departamento de garaje",
    text: "La Honda CB250 TwoFifty al detalle: kit de arrastre, zapatas de tambor, bujías, candado en U y una restauración completa de la maleta. Cada operación con manos, bielas y coste a la vista.",
    href: "https://www.youtube.com/tuanbyte",
  },
  {
    dept: "Hogar & obra",
    tag: "departamento de chalet",
    text: "Rejuntados, humedades, pintura de puertas y restauración de taburetes, con las herramientas low-cost de Parkside y Workzone testadas aquí delante, en garaje propio.",
    href: "https://www.youtube.com/tuanbyte",
  },
  {
    dept: "Tecnología",
    tag: "departamento de despacho",
    text: "Linux de sobremesa (Zorin OS), OBS, cámaras y la parte de GitHub donde vive esta web: lo que de verdad uso para grabar y publicar, con su precio.",
    href: "https://github.com/tuanbyte",
  },
];
---

<section id="secciones" class="scroll-mt-20 bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-20">
    <h2 class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl">
      Departamentos
    </h2>
    <p class="mt-2 font-marker text-2xl text-minium">
      qué vas a encontrar en este catálogo
    </p>

    <div class="mt-10 space-y-8">
      {
        secciones.map((s) => (
          <div class="canto grid items-baseline gap-3 bg-paper px-6 py-6 sm:grid-cols-[1fr_7rem_auto] sm:gap-8 sm:px-8">
            <div>
              <h3 class="font-display text-3xl font-bold uppercase tracking-tight text-ink">
                {s.dept}
              </h3>
              <p class="font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-minium">
                {s.tag}
              </p>
              <p class="mt-3 max-w-[68ch] leading-relaxed text-ink/85">{s.text}</p>
            </div>
            <div />
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="justify-self-start border-b-2 border-ink pb-0.5 font-marker text-xl text-ink transition-colors hover:border-minium hover:text-minium sm:justify-self-end"
            >
              pasillo ↗
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
