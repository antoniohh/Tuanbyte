---
interface Props {
  absolute?: boolean;
}

const { absolute = false } = Astro.props;
const path = Astro.url.pathname;
const enEspeciales = path.startsWith("/especiales");

const links = [
  { href: "#catalogo", label: "Catálogo" },
  { href: "#listas", label: "Listas de reproducción" },
  { href: "#especiales", label: "Especiales" },
  { href: "#contacto", label: "Contacto" },
].map((l) => ({ ...l, href: absolute ? `/${l.href}` : l.href }));
---

<header class="perfo-top border-b-2 border-ink bg-paper-2">
  <div class="pt-2.5 pb-2.5">
    <div class="mx-auto max-w-6xl">
      <div class="flex h-14 items-center justify-between gap-4 px-5 sm:px-8">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/brand/mark-256.png"
            alt=""
            width="36"
            height="36"
            class="h-9 w-9"
          />
          <span class="font-brand hidden text-2xl uppercase tracking-tight text-ink sm:inline">
            Tuanbyte
          </span>
        </a>

        <nav class="flex items-center gap-2" aria-label="Principal">
          <a
            href="/especiales"
            class:list={[
              "border border-ink-line px-2.5 py-2 font-mono text-[0.625rem] uppercase tracking-[0.1em] transition-colors sm:px-4 sm:py-1.5 sm:text-[0.6875rem] sm:tracking-[0.12em]",
              enEspeciales
                ? "bg-ink text-paper"
                : "bg-paper text-ink hover:border-ink hover:bg-strike/40",
            ]}
          >
            Especiales
          </a>

          <details class="group relative" data-menu>
          <summary
            class="flex cursor-pointer select-none items-center gap-2 border border-ink-line bg-paper px-2.5 py-2 font-mono text-[0.625rem] uppercase tracking-[0.1em] text-ink transition-colors hover:border-ink hover:bg-strike/40 sm:px-4 sm:py-1.5 sm:text-[0.6875rem] sm:tracking-[0.12em] [&::-webkit-details-marker]:hidden"
            aria-label="Secciones de la portada"
          >
            <span class="sm:hidden">Menú</span>
            <span class="hidden sm:inline">Secciones</span>
            <svg
              class="h-3 w-3 shrink-0 transition-transform group-open:rotate-180"
              viewBox="0 0 12 8"
              fill="none"
              aria-hidden="true"
            >
              <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="2" />
            </svg>
          </summary>
          <ul
            class="absolute right-0 z-50 mt-2 w-60 border-2 border-ink bg-paper py-1 shadow-[4px_4px_0_0_var(--color-paper-3)]"
          >
            {
              links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="block px-4 py-2.5 font-mono text-xs uppercase tracking-[0.1em] text-ink-soft transition-colors hover:bg-strike/30 hover:text-ink"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
          </details>
        </nav>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var menu = document.querySelector("details[data-menu]");
    if (!menu) return;
    document.addEventListener("click", function (ev) {
      if (!menu.contains(ev.target)) menu.open = false;
      else if (ev.target.closest("a")) menu.open = false;
    });
    document.addEventListener("keydown", function (ev) {
      if (ev.key === "Escape") menu.open = false;
    });
  })();
</script>
