---
const links = [
  { href: "#catalogo", label: "Catálogo" },
  { href: "#listas", label: "Listas" },
  { href: "#anexos", label: "Anexos" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="perfo-top border-b-2 border-ink bg-paper-2">
  <div class="pt-3">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
      <a href="/" class="flex items-baseline gap-2 font-display text-2xl font-bold tracking-tight text-ink">
        <span class="text-minium">&gt;_</span>
        Tuanbyte
      </a>
      <nav
        class="flex items-center gap-1 font-mono text-[0.6875rem] uppercase tracking-[0.12em] sm:gap-2"
        aria-label="Secciones del catálogo"
      >
        {
          links.map((l) => (
            <a
              href={l.href}
              class="border border-ink-line bg-paper px-2.5 py-2 transition-colors hover:border-ink hover:bg-strike/40 sm:px-4 sm:py-1.5"
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
