---
interface Props {
  absolute?: boolean;
}

const { absolute = false } = Astro.props;

const links = [
  { href: "#catalogo", label: "Catálogo" },
  { href: "#listas", label: "Listas" },
  { href: "#especiales", label: "Especiales" },
  { href: "#contacto", label: "Contacto" },
].map((l) => ({ ...l, href: absolute ? `/${l.href}` : l.href }));

const tabClass =
  "border border-ink-line bg-paper px-3 py-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] whitespace-nowrap transition-colors hover:border-ink hover:bg-strike/40 sm:px-4 sm:py-1.5";
---

<header class="perfo-top border-b-2 border-ink bg-paper-2">
  <div class="pt-2.5 pb-2.5">
    <div class="mx-auto max-w-6xl">
      <div class="flex h-14 items-center justify-between px-5 sm:px-8">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/brand/mark-256.png"
            alt=""
            width="36"
            height="36"
            class="h-9 w-9"
          />
          <span class="font-brand text-2xl uppercase tracking-tight text-ink">
            Tuanbyte
          </span>
        </a>
        <nav class="hidden items-center gap-2 md:flex" aria-label="Secciones del catálogo">
          {
            links.map((l) => (
              <a href={l.href} class={tabClass}>
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>
      <nav
        class="grid grid-cols-4 border-t border-dashed border-ink-line md:hidden"
        aria-label="Secciones del catálogo"
      >
        {
          links.map((l) => (
            <a
              href={l.href}
              class="border-r border-ink-line py-2 text-center font-mono text-[0.5625rem] uppercase tracking-[0.03em] text-ink-soft transition-colors last:border-r-0 hover:bg-strike/30 hover:text-ink min-[380px]:text-[0.625rem] min-[380px]:tracking-[0.08em]"
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
