---
import { socials, email } from "@/data/socials";
---

<section id="contacto" class="scroll-mt-20 border-b-2 border-ink bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl">
        Contacto y redes
      </h2>
      <p class="font-marker text-2xl text-minium">
        para lo que necesites, aquí estoy
      </p>
    </div>

    <div class="canto mt-10 grid border-2 border-ink bg-paper lg:grid-cols-5">
      <div class="border-b-2 border-ink px-6 py-8 sm:px-10 lg:col-span-2 lg:flex lg:flex-col lg:justify-center lg:border-b-0 lg:border-r-2">
        <p class="font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-ink-soft">
          correo
        </p>
        <p class="mt-4">
          <a
            href={`mailto:${email}`}
            class="font-marker text-3xl text-ink underline decoration-minium decoration-wavy underline-offset-4 transition-colors hover:text-minium sm:text-4xl"
          >
            {email}
          </a>
        </p>
        <p class="mt-6 max-w-[34ch] leading-relaxed text-ink-soft">
          Dudas, colaboraciones o lo que se te ocurra: escríbeme y te
          contesto yo.
        </p>
      </div>

      <div class="lg:col-span-3">
        <p class="border-b-2 border-ink px-6 py-4 font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-ink-soft sm:px-8">
          redes sociales
        </p>
        <ul>
          {
            socials.map((s, i) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class:list={[
                    "group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-6 py-4 transition-colors hover:bg-strike/30 sm:px-8",
                    i !== socials.length - 1 ? "border-b border-dashed border-ink-line" : "",
                  ]}
                >
                  <span class="font-display text-xl font-bold uppercase tracking-wide text-ink group-hover:text-minium">
                    {s.label}
                  </span>
                  <span class="font-mono text-xs text-ink-soft group-hover:text-minium">
                    {s.handle}
                    <span class="ml-2 inline-block transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                      ↗
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
