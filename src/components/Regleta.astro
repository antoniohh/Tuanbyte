---
interface Props {
  ultimoTexto: string;
  listados: number;
}

const { ultimoTexto, listados } = Astro.props;
---

<aside
  class="border-y-2 border-ink bg-ink text-paper"
  aria-label="Estado del catálogo"
>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-2 px-5 py-3 font-mono text-xs tracking-[0.08em] sm:px-8">
    <span class="flex items-center gap-2">
      <span class="regleta-dot inline-block h-2 w-2 bg-strike" aria-hidden="true"></span>
      <span class="uppercase tracking-[0.14em] text-paper">Últimos vídeos</span>
    </span>
    <span>fecha del último vídeo: <span class="text-strike">{ultimoTexto}</span></span>
    <span>vídeos listados: <span class="text-strike">{listados}</span></span>
    <span class="sm:ml-auto">
      <a
        href="https://www.youtube.com/tuanbyte"
        target="_blank"
        rel="noopener"
        class="text-strike underline decoration-dotted underline-offset-2"
      >
        todos los vídeos ↗
      </a>
    </span>
  </div>
</aside>
